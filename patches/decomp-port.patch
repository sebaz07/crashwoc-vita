+/* debug aid (CWOC_TELEPORT=x,y,z@frame): move the player once at that frame */
+void port_teleport(int frame) {
+    extern void port_log(const char *fmt, ...);
+    /* CWOC_TELEPORT="x,y,z@frame;bonus@frame;..." (bonus = the bonus round in-platform) */
+    static int parsed, nt, blog = -1;
+    static int at[8], bonus_tp[8];
+    static float tx[8], ty[8], tz[8];
+    extern struct rail_s Rail[8];
+    extern s32 Bonus, bonus_restart, bonus_finish_frame, save_bonus_crates_destroyed, bonus_lives;
+    int i;
+    if (!parsed) {
+        const char *t = getenv("CWOC_TELEPORT");
+        parsed = 1;
+        blog = getenv("CWOC_BONUSLOG") != NULL;
+        while (t != NULL && *t && nt < 8) {
+            if (sscanf(t, "bonus@%d", &at[nt]) == 1) {
+                bonus_tp[nt++] = 1;
+            } else if (sscanf(t, "%f,%f,%f@%d", &tx[nt], &ty[nt], &tz[nt], &at[nt]) == 4) {
+                bonus_tp[nt++] = 0;
+            }
+            t = strchr(t, ';');
+            if (t != NULL) t++;
+        }
+    }
+    if (blog && (frame % 15) == 0) {
+        struct creature_s *c = &Character[0];
+        extern f32 bonus_wumpa_wait, bonus_crates_wait, bonus_lives_wait;
+        if (c->obj.dead != 0)
+            port_log("bonus: wumpas %d wdelay %d wwait %.2f cwait %.2f ldelay %d lwait %.2f new_mode %d new_level %d",
+                     plr_bonus_wumpas.count, bonus_wumpa_delay, bonus_wumpa_wait, bonus_crates_wait,
+                     bonus_life_delay, bonus_lives_wait, new_mode, new_level);
+        port_log("bonus: f%d Bonus %d pos %.2f %.2f %.2f momy %.3f dead %d die %.2f/%.2f shadow %.1f ground %d surf %d restart %d bff %d crates %d lives %d",
+                 frame, Bonus, c->obj.pos.x, c->obj.pos.y, c->obj.pos.z, c->obj.mom.y, c->obj.dead,
+                 c->obj.die_time, c->obj.die_duration, c->obj.shadow, c->obj.ground, c->obj.surface_type,
+                 bonus_restart, bonus_finish_frame, save_bonus_crates_destroyed, bonus_lives);
+    }
+    for (i = 0; i < nt; i++) {
+        float x = tx[i], y = ty[i], z = tz[i];
+        struct creature_s *c = &Character[0];
+        if (frame != at[i]) continue;
+        if (bonus_tp[i]) {
+            struct rail_s *r = &Rail[5];
+            if (r->type != -1 && r->pINPLAT != NULL) {
+                struct nuvec_s *v = (struct nuvec_s *)r->pINPLAT->pts;
+                x = v->x; y = v->y + 1.0f; z = v->z;
+            } else {
+                port_log("teleport: level has no bonus rail");
+                continue;
+            }
+        }
+        c->obj.pos.x = x; c->obj.pos.y = y; c->obj.pos.z = z;
+        c->obj.oldpos = c->obj.pos;
+        port_log("teleport player to %.2f %.2f %.2f", x, y, z);
+    }
+}
