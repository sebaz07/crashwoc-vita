+static void port_swap_cutscene_image(struct NUGCUTSCENE_s *cs) {
+    s32 delta, i;
+    port_swap32(cs, 10);
+    delta = (s32)cs - cs->address_offset;
+    port_visit_reset();
+    if (cs->bbox != NULL) port_swap32(PORT_CUT_PTR(cs->bbox), 6);
+    if (cs->cameras != NULL) {
+        struct NUGCUTCAMSYS_s *cam = PORT_CUT_PTR(cs->cameras);
+        PORT_S32(cam->ncutcams);
+        PORT_S32(cam->cutcams);
+        PORT_S32(cam->camanim);
+        PORT_S32(cam->camchanges);
+        if (cam->cutcams != NULL) {
+            struct NUGCUTCAM_s *cc = PORT_CUT_PTR(cam->cutcams);
+            for (i = 0; i < (s32)cam->ncutcams; i++) port_swap32(&cc[i].mtx, 16);
+        }
+        port_swap_cut_animdata2(PORT_CUT_PTR(cam->camanim), delta);
+        port_swap_cut_stateanim(PORT_CUT_PTR(cam->camchanges), delta);
+    }
+    if (cs->locators != NULL) {
+        struct NUGCUTLOCATORSYS_s *ls = PORT_CUT_PTR(cs->locators);
+        PORT_S32(ls->locators);
+        PORT_S32(ls->locator_types);
+        if (ls->locators != NULL) {
