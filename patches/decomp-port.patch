+            port_log("cre ai%d type%d status%d time %.2f delay %.2f typedelay %.2f", c->i_aitab, AITab[c->i_aitab].ai_type,
+                     AITab[c->i_aitab].status, AITab[c->i_aitab].time, AITab[c->i_aitab].delay,
+                     AIType[AITab[c->i_aitab].ai_type].delay);
+        port_log("cre f%d i%d ch%d dead%d pos %.2f %.2f %.2f mom %.3f %.3f %.3f", frame, i, c->obj.character,
+                 c->obj.dead, c->obj.pos.x, c->obj.pos.y, c->obj.pos.z, c->obj.mom.x, c->obj.mom.y, c->obj.mom.z);
+    }
+}
