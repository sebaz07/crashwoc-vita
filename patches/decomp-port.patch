 void NuQuatSlerp(f32 alpha, struct Quat* dest, struct Quat* a, struct Quat* b)
 {
+#ifdef PORT
+	{
+		/* the original (800C0EDC) uses the dot product a.b (not |a|^2) and
+		   computes the weights in double precision */
+		f64 d = a->x * b->x + a->y * b->y + a->z * b->z + a->w * b->w;
+		f64 sa, sb;
+		f32 bx = b->x, by = b->y, bz = b->z, bw = b->w;
+		if (d < 0.0) {
+			bx = -bx; by = -by; bz = -bz; bw = -bw;
+			d = -d;
+		}
+		if (1.0 - d > 0.0) {
+			f64 ac = acos(d);
+			f64 s = sin(ac);
+			sa = sin((1.0 - alpha) * ac) / s;
+			sb = sin(alpha * ac) / s;
+		} else {
+			sa = 1.0 - alpha;
+			sb = alpha;
+		}
+		dest->x = (f32)(sa * a->x + sb * bx);
+		dest->y = (f32)(sa * a->y + sb * by);
+		dest->z = (f32)(sa * a->z + sb * bz);
+		dest->w = (f32)(sa * a->w + sb * bw);
+		return;
+	}
+#endif
 	f32 mag = a->x * a->x + a->y * a->y + a->z * a->z + a->w * a->w;
 	f32 x = b->x;
 	f32 y = b->y;
