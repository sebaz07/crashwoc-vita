+/* debug aid (CWOC_STRETCHLOG=1, tools/ppc2c.py HOOKS): joint scale and extent
+ * of every skinned model drawn by the translated DrawCharacterModel */
+s32 port_hook_NuHGobjRndrMtxDwa(struct NUHGOBJ_s *hgobj, struct numtx_s *wm, int nlayers, short *layers,
+                                struct numtx_s *tmtx, float **dwa) {
+    static int on = -1;
+    extern void port_log(const char *fmt, ...);
+    extern int port_frame_count(void);
+    if (on < 0) on = getenv("CWOC_STRETCHLOG") != NULL;
+    if (on && hgobj != NULL && tmtx != NULL) {
+        s32 j, n = hgobj->num_joints, jmax = 0;
+        float smin = 1e9f, smax = 0.0f, ext = 0.0f;
+        for (j = 0; j < n; j++) {
+            struct numtx_s *t = &tmtx[j];
+            float c0 = t->_00 * t->_00 + t->_01 * t->_01 + t->_02 * t->_02;
+            float c1 = t->_10 * t->_10 + t->_11 * t->_11 + t->_12 * t->_12;
+            float c2 = t->_20 * t->_20 + t->_21 * t->_21 + t->_22 * t->_22;
+            float dx = t->_30 - tmtx[0]._30, dy = t->_31 - tmtx[0]._31, dz = t->_32 - tmtx[0]._32;
+            float d = dx * dx + dy * dy + dz * dz;
+            if (c0 < smin) smin = c0;
+            if (c1 < smin) smin = c1;
+            if (c2 < smin) smin = c2;
+            if (c0 > smax) smax = c0;
+            if (c1 > smax) smax = c1;
+            if (c2 > smax) smax = c2;
+            if (d > ext) { ext = d; jmax = j; }
+        }
+        port_log("stretch f%d hobj %p nj %d s2 %.3f..%.3f ext2 %.3f j%d pos %.1f %.1f %.1f", port_frame_count(),
+                 (void *)hgobj, n, smin, smax, ext, jmax, wm ? wm->_30 : 0.0f, wm ? wm->_31 : 0.0f,
+                 wm ? wm->_32 : 0.0f);
+    }
+    return NuHGobjRndrMtxDwa(hgobj, wm, nlayers, layers, tmtx, dwa);
+}
+#endif
