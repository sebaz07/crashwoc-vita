+#ifdef PORT
+/* Byte-swap a .cut memory image (NUGCUTSCENE_s graph) in place, following the
+ * same pointers as the *FixPtrs functions below. Stored pointers are addresses
+ * in the original layout: 'delta' maps them into the buffer. Bit masks of the
+ * anim curves are read byte by byte and stay as they are. */
+#define PORT_CUT_PTR(v) ((v) ? (void *)((s32)(v) + delta) : NULL)
+#define PORT_S32(f) port_swap32(&(f), 1)
+#define PORT_S16(f) port_swap16(&(f), 1)
+
+static void port_swap_cut_stateanim(struct NUSTATEANIM_s *sa, s32 delta) {
+    if (sa == NULL || !port_visit_once(sa)) return;
+    port_swap32(sa, 3);
+    if (sa->frames != NULL && port_visit_once(PORT_CUT_PTR(sa->frames)))
+        port_swap32(PORT_CUT_PTR(sa->frames), sa->nchanges);
+}
+
+static int port_popcount32(const u8 *m) {
+    return __builtin_popcount(m[0]) + __builtin_popcount(m[1]) + __builtin_popcount(m[2]) + __builtin_popcount(m[3]);
+}
+
+static void port_swap_cut_animdata2(struct nuanimdata2_s *ad, s32 delta) {
+    s32 k, c, total;
+    struct nuanimcurve2_s *curves;
+    char *flags;
+    if (ad == NULL || !port_visit_once(ad)) return;
+    PORT_S32(ad->endframe);
+    PORT_S16(ad->nnodes);
+    PORT_S16(ad->ncurves);
+    PORT_S16(ad->nchunks);
+    PORT_S16(ad->pad);
+    PORT_S32(ad->curves);
+    PORT_S32(ad->curveflags);
+    PORT_S32(ad->curvesetflags);
+    if (ad->curves == NULL) return;
+    curves = PORT_CUT_PTR(ad->curves);
+    flags = PORT_CUT_PTR(ad->curveflags);
+    total = ad->nnodes * ad->ncurves;
+    if (!port_visit_once(curves)) return;
+    port_swap32(curves, total);
+    if (flags == NULL) return;
+    for (k = 0; k < total; k++) {
+        struct nuanimcurvedata_s *cd;
+        u8 *mask;
+        u16 *ixs;
+        s32 nkeys = 0;
+        if (flags[k] == 0 || curves[k].data.curvedata == NULL) continue;
+        cd = PORT_CUT_PTR(curves[k].data.curvedata);
+        if (!port_visit_once(cd)) continue;
+        port_swap32(cd, 3);
+        mask = PORT_CUT_PTR(cd->mask);
+        ixs = PORT_CUT_PTR(cd->key_ixs);
+        if (ixs != NULL && port_visit_once(ixs)) port_swap16(ixs, ad->nchunks);
+        if (mask == NULL || ixs == NULL || cd->key_array == NULL) continue;
+        for (c = 0; c < ad->nchunks; c++) {
+            s32 n = ixs[c] + port_popcount32(mask + c * 4);
+            if (n > nkeys) nkeys = n;
+        }
+        if (!port_visit_once(PORT_CUT_PTR(cd->key_array))) continue;
+        switch (flags[k]) {
+        case NUANIMKEYTYPE_BIG: port_swap32(PORT_CUT_PTR(cd->key_array), nkeys * 4); break;
+        case NUANIMKEYTYPE_INTEGER: port_swap32(PORT_CUT_PTR(cd->key_array), nkeys * 2); break;
+        case NUANIMKEYTYPE_SMALL: port_swap16(PORT_CUT_PTR(cd->key_array), nkeys * 2); break;
+        default: break;
+        }
+    }
+}
+
+static void port_swap_cut_locator(struct NUGCUTLOCATOR_s *loc, s32 delta) {
+    if (!port_visit_once(loc)) return;
+    port_swap32(&loc->mtx, 16);
+    port_swap32(&loc->pivot, 3);
+    PORT_S32(loc->rate);
+    PORT_S32(loc->anim);
+    PORT_S32(loc->direction);
+    PORT_S32(loc->param1);
+    PORT_S32(loc->param2);
+    port_swap_cut_animdata2(PORT_CUT_PTR(loc->anim), delta);
+}
