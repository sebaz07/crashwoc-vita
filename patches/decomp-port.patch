+#ifdef PORT
+/* Convert a big-endian .ter image in place before ReadTerrain walks it.
+ * Layout: s32 offset (in shorts) to an OffFileType table; data blocks start
+ * right after that first word, each 'offset' shorts long:
+ *   type 0/1: model groups [s16 id][s16 n][4 floats bbox] + n tertype records
+ *             (24 floats + 4 info bytes), terminated by a negative id;
+ *   type 2:   wall spline: s32 marker, u16 count, u16 val, count nuvec_s;
+ *   type 3:   crash data (left untouched, unused by the game code). */
+static void port_swap_terrain(short *ts, s32 fsize) {
+    static const unsigned char rotflag[] = { 1 };
+    char *end = (char *)ts + fsize;
+    OffFileType *sp;
+    short *st;
+    s32 lp, cnt;
+    port_swap32(ts, 1);
+    sp = (OffFileType *)(ts + *(s32 *)ts);
+    port_swap32(&sp->count, 1);
+    cnt = sp->count & 0xffff;
+    for (lp = 0; lp < cnt; lp++) {
+        OffType *o = &sp->offlist[lp];
+        u32 f;
+        port_swap32(&o->offset, 4);       /* offset, translation */
+        port_swap16(&o->type, 6);         /* type info rx ry rz pad */
+        port_swap32(&o->rotation, 3);
+        memcpy(&f, &o->flags, 4);
+        f = __builtin_bswap32(f); (void)rotflag; /* TERRAINFLAGS declared reversed under PORT */
+        memcpy(&o->flags, &f, 4);
+        port_swap16(&o->prim, 2);
+        port_swap32(&o->datapos, 1);
+    }
+    st = ts + 2;
+    for (lp = 0; lp < cnt; lp++) {
+        OffType *o = &sp->offlist[lp];
+        short *blk_end = st + o->offset;
+        if ((char *)blk_end > end) blk_end = (short *)end;
+        switch (o->type) {
+        case 0:
+        case 1: {
+            short *m = st;
+            while (m + 1 < blk_end) {
+                s32 n;
+                port_swap16(m, 2);
+                if (m[0] < 0) break;
+                n = m[1];
+                port_swap32(m + 2, 4);
+                {
+                    char *t = (char *)(m + 10);
+                    s32 k;
+                    for (k = 0; k < n && t + sizeof(tertype) <= (char *)blk_end; k++, t += sizeof(tertype))
+                        port_swap32(t, 24);
+                    m = (short *)t;
+                }
+            }
+            break;
+        }
+        case 2:
+            if (st + 4 <= blk_end) {
+                s32 n;
+                port_swap32(st, 1);
+                port_swap16(st + 2, 2);
+                n = (u16)st[2];
+                if ((char *)(st + 4) + n * 12 <= (char *)blk_end) port_swap32(st + 4, n * 3);
+            }
+            break;
+        default:
+            break;
+        }
+        st = blk_end;
+    }
+}
+#endif
