@@ -161,6 +161,10 @@ static uint8_t *circular_data_pool_limit;
 #endif
 uint32_t circular_data_pool_size = CIRCULAR_POOL_SIZE_DEF;
 uint8_t *vgl_reserve_data_pool(uint32_t size) {
+	// keep every reservation 8-byte aligned: an odd-sized one (16-bit indices)
+	// left the next float data misaligned (glBlitFramebuffer's vertices: a
+	// data abort on the console)
+	size = (size + 7) & ~7u;
 #ifndef CIRCULAR_POOL_SPEEDHACK
 	uint8_t *res = circular_data_pool_ptr[vgl_circular_idx];
 	circular_data_pool_ptr[vgl_circular_idx] += size;
@@ -859,6 +863,15 @@ void vglSetShaderCachePath(const char *path) {
 #endif
 }
 
+void vglSetShaderCacheSeedPath(const char *path) {
+#ifdef HAVE_SHADER_CACHE
+	if (path && path[0] && strlen(path) < sizeof(vgl_shader_cache_seed) - 8)
+		sprintf(vgl_shader_cache_seed, "%s/v%d", path, SHADER_CACHE_MAGIC);
+	else
+		vgl_shader_cache_seed[0] = 0;
+#endif
+}
