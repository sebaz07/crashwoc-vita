+char vgl_shader_cache_seed[256]; // read-only fallback with the same layout (vglSetShaderCacheSeedPath), "" = none
+
+#ifdef HAVE_SHADER_CACHE
+// a cached shader file: the cache first, then the same name under the seed
+// (e.g. shaders shipped in app0:, compiled ahead of time)
+static SceUID cache_open(const char *fname) {
+	SceUID f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+	if (f < 0 && vgl_shader_cache_seed[0]) {
+		size_t n = strlen(vgl_shader_cache_path);
+		char alt[256];
+		if (!strncmp(fname, vgl_shader_cache_path, n) && strlen(vgl_shader_cache_seed) + strlen(fname + n) < sizeof(alt)) {
+			sprintf(alt, "%s%s", vgl_shader_cache_seed, fname + n);
+			f = sceIoOpen(alt, SCE_O_RDONLY, 0777);
+		}
+	}
+	return f;
+}
+#endif
 #endif
 #ifdef HAVE_TEX_CACHE
 char vgl_file_cache_path[256];
